{
  "manifest_version": 3,
  "name": "ApplyPilot",
  "version": "0.3.0",
  "description": "Job-search copilot: one-click apply on LinkedIn Easy Apply, Naukri and Indeed, fills any application, saves jobs, finds the hiring contact and drafts referral notes.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ApplyPilot"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}