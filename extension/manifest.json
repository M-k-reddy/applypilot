{
  "manifest_version": 3,
  "name": "ApplyPilot \u2013 AI job copilot",
  "short_name": "ApplyPilot",
  "version": "2.7.0",
  "description": "Save jobs, see your match, fill application forms in one click. Optional Auto mode applies only when confident.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.naukri.com/*",
    "https://*.naukri.com/*",
    "https://internshala.com/*",
    "https://*.internshala.com/*",
    "https://in.indeed.com/*",
    "https://smartapply.indeed.com/*",
    "https://apply.indeed.com/*",
    "https://m5.apply.indeed.com/*",
    "https://www.foundit.in/*",
    "https://*.foundit.in/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open ApplyPilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Open ApplyPilot"
    }
  },
  "externally_connectable": {
    "matches": [
      "https://applypilot-theta.vercel.app/*",
      "http://localhost:3000/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png"
      ],
      "matches": [
        "https://*.naukri.com/*",
        "https://internshala.com/*",
        "https://*.indeed.com/*",
        "https://*.foundit.in/*",
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
