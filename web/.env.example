NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of the deployed app (used for links in alert emails)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

LLM_PROVIDER=ollama
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
# optional fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Vercel Cron auth: Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/cron/*
CRON_SECRET=

# Optional: email job alerts through Resend (free tier). Without it, alerts are in-app notifications only.
RESEND_API_KEY=
ALERTS_FROM_EMAIL=ApplyPilot <alerts@yourdomain.com>

# Optional: override the seed company list for the free feed (JSON array of {ats, token, name})
FEED_COMPANIES_JSON=

# Optional: JSearch (RapidAPI) as an extra job source. The free feed works without it.
RAPIDAPI_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# Free-plan monthly caps (Pro is unlimited). FREE_MONTHLY_LIMIT = autofills.
FREE_MONTHLY_LIMIT=5
FREE_LIMIT_ATS=5
FREE_LIMIT_ATS_FIX=10
FREE_LIMIT_TAILOR=2
FREE_LIMIT_MATCH=20
FREE_LIMIT_OUTREACH=5
FREE_LIMIT_FIND_HR=5
