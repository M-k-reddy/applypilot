# ───────── Supabase (free tier) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this in the browser or the extension.
SUPABASE_SERVICE_ROLE_KEY=

# ───────── AI: gemini (default, free tier) | groq (free tier) | ollama
LLM_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: Groq (OpenAI-compatible, free tier) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: Ollama Cloud (OLLAMA_API_KEY) or self-hosted (OLLAMA_HOST=http://localhost:11434)
OLLAMA_API_KEY=
OLLAMA_HOST=
OLLAMA_MODEL=gpt-oss:120b

# ───────── Jobs (Remotive + Arbeitnow need no key)
# Optional but recommended for India jobs: free key at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional: JSearch via RapidAPI
RAPIDAPI_KEY=

# ───────── Free plan monthly quotas (reset on the 1st, IST)
FREE_ANALYSES=30
FREE_TAILORS=15
FREE_COVER_LETTERS=10
FREE_AUTOFILLS=50
FREE_PARSES=10

# ───────── Razorpay (optional). Leave all four empty to hide the upgrade UI.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
